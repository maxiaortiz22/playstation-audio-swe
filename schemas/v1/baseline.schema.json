{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audio-validation-systems-lab.invalid/schemas/v1/baseline.schema.json",
  "title": "Audio Validation Systems Lab approved baseline descriptor v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "generation",
    "test_id",
    "manifest_schema_version",
    "manifest_sha256",
    "sut",
    "environment_class",
    "generator_metadata",
    "pcm",
    "approval",
    "prior_generations"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "baseline_id": { "$ref": "#/$defs/identifier" },
    "generation": { "type": "integer", "minimum": 1 },
    "test_id": { "$ref": "#/$defs/identifier" },
    "manifest_schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "sut": { "$ref": "#/$defs/sut" },
    "environment_class": { "$ref": "#/$defs/non_empty_string" },
    "generator_metadata": { "$ref": "#/$defs/generator_metadata" },
    "pcm": { "$ref": "#/$defs/pcm" },
    "approval": { "$ref": "#/$defs/approval" },
    "prior_generations": {
      "type": "array",
      "items": { "$ref": "#/$defs/prior_generation" }
    }
  },
  "$defs": {
    "non_empty_string": { "type": "string", "minLength": 1 },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "parameters": { "type": "object" },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "$ref": "#/$defs/identifier" }
      }
    },
    "generator_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generator",
        "parameters",
        "seed",
        "audio_format",
        "channel_map",
        "manifest_sha256",
        "pcm_sha256"
      ],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": {
              "type": "string",
              "enum": ["constant", "impulse", "channel-identification", "prbs15"]
            },
            "version": { "const": "1" }
          }
        },
        "parameters": { "$ref": "#/$defs/parameters" },
        "seed": { "type": "integer", "minimum": 0, "maximum": 32767 },
        "audio_format": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sample_rate_hz",
            "frame_count",
            "channel_count",
            "sample_format",
            "layout",
            "endianness",
            "full_scale_min",
            "full_scale_max"
          ],
          "properties": {
            "sample_rate_hz": { "type": "integer", "minimum": 1 },
            "frame_count": { "type": "integer", "minimum": 1 },
            "channel_count": { "type": "integer", "minimum": 1 },
            "sample_format": { "const": "float32" },
            "layout": { "const": "frames_channels_interleaved" },
            "endianness": { "const": "little" },
            "full_scale_min": { "const": -1.0 },
            "full_scale_max": { "const": 1.0 }
          }
        },
        "channel_map": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/channel" }
        },
        "manifest_sha256": { "$ref": "#/$defs/sha256" },
        "pcm_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sut": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "parameters"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "version": { "$ref": "#/$defs/non_empty_string" },
        "parameters": { "$ref": "#/$defs/parameters" }
      }
    },
    "pcm": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_path", "sha256", "byte_count", "encoding", "shape"],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.pcm\\.f32le$"
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_count": { "type": "integer", "minimum": 4 },
        "encoding": { "const": "ieee754_float32_little_endian_frames_channels" },
        "shape": {
          "type": "array",
          "prefixItems": [
            { "type": "integer", "minimum": 1 },
            { "type": "integer", "minimum": 1 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "rationale", "approved_at"],
      "properties": {
        "reviewer": { "$ref": "#/$defs/non_empty_string" },
        "rationale": { "$ref": "#/$defs/non_empty_string" },
        "approved_at": { "type": "string", "format": "date-time" }
      }
    },
    "prior_generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "descriptor_sha256", "pcm_sha256", "approval"],
      "properties": {
        "generation": { "type": "integer", "minimum": 1 },
        "descriptor_sha256": { "$ref": "#/$defs/sha256" },
        "pcm_sha256": { "$ref": "#/$defs/sha256" },
        "approval": { "$ref": "#/$defs/approval" }
      }
    }
  }
}
