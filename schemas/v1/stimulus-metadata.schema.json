{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://audio-validation-systems-lab.invalid/schemas/v1/stimulus-metadata.schema.json",
  "title": "Audio Validation Systems Lab generated stimulus metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generator",
    "parameters",
    "seed",
    "audio_format",
    "channel_map",
    "manifest_sha256",
    "pcm_sha256"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "generator": { "$ref": "#/$defs/generator" },
    "parameters": { "type": "object" },
    "seed": { "type": "integer", "minimum": 0, "maximum": 32767 },
    "audio_format": { "$ref": "#/$defs/audio_format" },
    "channel_map": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/channel" }
    },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "pcm_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["constant", "impulse", "channel-identification", "prbs15"]
        },
        "version": { "const": "1" }
      }
    },
    "audio_format": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rate_hz",
        "frame_count",
        "channel_count",
        "sample_format",
        "layout",
        "endianness",
        "full_scale_min",
        "full_scale_max"
      ],
      "properties": {
        "sample_rate_hz": { "type": "integer", "minimum": 1 },
        "frame_count": { "type": "integer", "minimum": 1 },
        "channel_count": { "type": "integer", "minimum": 1 },
        "sample_format": { "const": "float32" },
        "layout": { "const": "frames_channels_interleaved" },
        "endianness": { "const": "little" },
        "full_scale_min": { "const": -1.0 },
        "full_scale_max": { "const": 1.0 }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "id"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "id": { "$ref": "#/$defs/identifier" }
      }
    }
  }
}
